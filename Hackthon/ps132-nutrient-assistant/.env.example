# Google Gemini API Key (optional: app falls back to deterministic summaries and mock/local vision if omitted)
GEMINI_API_KEY=

# USDA FoodData Central API Key (optional: defaults to DEMO_KEY for ingest_usda.py; seed_data works offline)
USDA_FDC_API_KEY=DEMO_KEY

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# SQLITE_DB_PATH=data/nutrients.db
# CHROMA_PERSIST_DIR=data/chroma_db
# PORT=8000
